generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── ПОЛЬЗОВАТЕЛИ ───────────────────────────

model User {
  id        String     @id @default(uuid())
  username  String     @unique
  pwdHash   String
  email     String     @unique
  phone     String?    @unique
  status    String     @default("INACTIVE") // INACTIVE | ACTIVE | BANNED | DELETED
  type      String     @default("COMMON")   // COMMON | COMPANY | MODERATOR | EDITOR | SUPER | ROOT
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  profile               UserProfile?
  serviceFields         UserServiceFields?
  admin                 Admin?
  givenReviews          Review[]              @relation("ReviewAuthor")
  receivedReviews       Review[]              @relation("ReviewTarget")
  documents             LibraryDocument[]
  conferences           Conference[]
  products              Product[]
  wallet                Wallet?
  treeSnapshots         TreeSnapshot[]
  invoices              Invoice[]
  transactions          Transaction[]
  addedCompanies        Company[]             @relation("AddedCompanies")
  ownedCompany          Company?              @relation("OwnedCompany")
  companyInvites        CompanyInvite[]
  documentPurchases     DocumentPurchase[]
  conferenceParticipants ConferenceParticipant[]
  pollVotes             PollVote[]
  giftClaims            GiftClaim[]
  supportTickets        SupportTicket[]
  supportMessages       SupportMessage[]
  notifications         Notification[]

  @@map("users")
}

model UserProfile {
  userId           String            @id
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName        String?
  lastName         String?
  middleName       String?
  nick             String?           @unique
  regions          String            @default("") // comma-separated; «Все регионы» — все регионы
  roles            UserProfileRole[]
  classifierIds    String            @default("") // comma-separated
  isContactsHidden Boolean           @default(true)

  // Поля компании
  inn              String?           @unique
  companyName      String?
  kpp              String?
  legalAddress     String?
  directorName     String?

  @@map("user_profiles")
}

model UserProfileRole {
  id        String  @id @default(uuid())
  profileId String
  profile   UserProfile @relation(fields: [profileId], references: [userId], onDelete: Cascade)
  role      String  // PRODUCTOLOGIST | TENDER_SPECIALIST | DESIGNER | COMPANY_OWNER | OTHER

  @@map("user_profile_roles")
}

// ─────────────────────────── СПРАВОЧНИКИ ───────────────────────────

model Region {
  id        String   @id @default(uuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("regions")
}

// Юридические документы (PDF) для /privacy и /terms
model LegalDocument {
  key       String   @id // "privacy" | "terms"
  fileName  String
  fileUrl   String
  fileSize  Int      @default(0)
  text      String   @default("") // текст документа: введённый вручную или извлечённый из PDF
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("legal_documents")
}

model UserServiceFields {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailVerifToken String?
  isEmailVerified Boolean  @default(false)
  isPhoneVerified Boolean  @default(false)
  refreshTokenHash String?
  banReason       String?

  @@map("user_service_fields")
}

model Admin {
  userId      String @id
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions String @default("{}") // JSON
  adminType   String // MODERATOR | EDITOR | SUPER | ROOT

  @@map("admins")
}

// ─────────────────────────── ПРОДУКТОВОЕ ДЕРЕВО ───────────────────────────

model ProductTreeItem {
  id             String            @id @default(uuid())
  name           String
  parentId       String?
  parent         ProductTreeItem?  @relation("TreeChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children       ProductTreeItem[] @relation("TreeChildren")
  inBranchNumber Int
  fullNumberPath String
  description    String?
  bannerUrl      String?
  unitOptions     String  @default("[]") // JSON: string[] — единицы измерения категории
  characteristics String  @default("[]") // JSON: [{name, value, unit}] — шаблон характеристик
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  products       Product[]
  documents      LibraryDocument[]
  conferences    Conference[]
  polls          Poll[]

  @@index([parentId])
  @@index([fullNumberPath])
  @@map("product_tree_items")
}

// ─────────────────────────── КОМПАНИИ ───────────────────────────

model Company {
  id            String          @id @default(uuid())
  inn           String          @unique
  name          String
  kpp           String?
  legalAddress  String?
  phone         String?
  email         String?
  website       String?
  regions       String          @default("") // comma-separated; «Все регионы» — все регионы
  classifierIds String          @default("") // comma-separated
  addedById     String?
  addedBy       User?           @relation("AddedCompanies", fields: [addedById], references: [id])
  ownerUserId   String?         @unique
  ownerUser     User?           @relation("OwnedCompany", fields: [ownerUserId], references: [id])
  reviews       Review[]
  products      Product[]
  metrics       CompanyMetrics?
  viewEvents    CompanyViewEvent[]
  billing       CompanyBilling?
  hiddenPeriods BillingHiddenPeriod[]
  invites       CompanyInvite[]
  notes         CompanyNote[]
  // Имя + ИНН в нижнем регистре — поиск по кириллице (LIKE в SQLite чувствителен к регистру)
  searchText    String          @default("")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([searchText])
  @@map("companies")
}

model CompanyMetrics {
  companyId    String  @id
  company      Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  phoneViews   Int     @default(0)
  emailViews   Int     @default(0)
  websiteViews Int     @default(0)
  reviewsViews Int     @default(0)
  ratingViews  Int     @default(0)

  @@map("company_metrics")
}

// Журнал просмотров контактов компании — источник данных для биллинга.
// Каждый клик по «глазу» фиксируется отдельным событием, чтобы счёт можно
// было выставить за произвольный период и видеть историю.
model CompanyViewEvent {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  metric    String   // phone | email | website | reviews | rating
  viewerId  String?
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([companyId, metric, createdAt])
  @@map("company_view_events")
}

// Биллинг компании: индивидуальные ставки (₽), статус и «водяная отметка» —
// дата, по которую просмотры уже выставлены в счёт (включительно).
// Пустые ставки означают значения по умолчанию из BillingConfig.
model CompanyBilling {
  companyId        String    @id
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status           String    @default("INACTIVE") // INACTIVE | ACTIVE | HIDDEN
  maintenanceFee   Decimal?
  phonePrice       Decimal?
  emailPrice       Decimal?
  websitePrice     Decimal?
  reviewsPrice     Decimal?
  ratingPrice      Decimal?
  monthlyCap       Decimal?
  billingStartedAt DateTime?
  billedThrough    DateTime?
  hiddenReason     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("company_billing")
}

// Интервал скрытия контактов (санкция за неуплату). Пока контакты скрыты,
// абонентская плата не начисляется: дни скрытия исключаются из счёта.
// to = null — интервал ещё открыт (компания скрыта сейчас).
model BillingHiddenPeriod {
  id        String    @id @default(uuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  from      DateTime
  to        DateTime?
  createdAt DateTime  @default(now())

  @@index([companyId])
  @@map("billing_hidden_periods")
}

// Заметки администратора о компании: как зарегистрировалась, договорённости
// об оплате, что нужно проверить. Дата проставляется автоматически.
model CompanyNote {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@map("company_notes")
}

// Одноразовая ссылка-приглашение для передачи карточки компании владельцу.
model CompanyInvite {
  id          String    @id @default(uuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  token       String    @unique
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id])
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@map("company_invites")
}

// ─────────────────────────── ОТЗЫВЫ И РЕЙТИНГ ───────────────────────────

model Review {
  id              String           @id @default(uuid())
  authorId        String
  author          User             @relation("ReviewAuthor", fields: [authorId], references: [id])
  targetId        String
  target          User             @relation("ReviewTarget", fields: [targetId], references: [id])
  companyId       String?
  company         Company?         @relation(fields: [companyId], references: [id])
  comment         String
  signatureType   String           @default("nick")
  criteria        ReviewCriteria[]
  weightedAverage Float
  status          String           @default("ACTIVE") // ACTIVE | HIDDEN
  reports         ReviewReport[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("reviews")
  @@index([companyId])
  @@index([targetId])
  @@index([status])
}

model ReviewReport {
  id        String   @id @default(uuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String?
  reason    String
  createdAt DateTime @default(now())

  @@map("review_reports")
  @@index([reviewId])
}

model ReviewCriteria {
  id            String  @id @default(uuid())
  reviewId      String
  review        Review  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  criteriaIndex Int
  score         Int

  @@map("review_criteria")
}

// ─────────────────────────── МАТРИЦА МАТЕРИАЛОВ ───────────────────────────

model Product {
  id              String           @id @default(uuid())
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id])
  ownerUserId     String?
  ownerUser       User?            @relation(fields: [ownerUserId], references: [id])
  treeItemId      String
  treeItem        ProductTreeItem  @relation(fields: [treeItemId], references: [id])
  name            String
  description     String? // описание товара (показывается в карточке)
  // Название в нижнем регистре — поиск по кириллице (LIKE в SQLite чувствителен к регистру)
  searchText      String           @default("")
  status          String           @default("PUBLISHED") // DRAFT | PUBLISHED
  classes         String           @default("[]") // JSON array: ["STANDARD","COMFORT",...]
  regions         String           @default("") // comma-separated; «Все регионы» — все регионы
  imageUrl        String?
  unit            String?
  characteristics String           @default("[]") // JSON
  price           Float?
  views           Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  @@map("products")
  @@index([deletedAt])
  @@index([treeItemId])
  @@index([searchText])
}

// ─────────────────────────── БИБЛИОТЕКА ДОКУМЕНТОВ ───────────────────────────

model LibraryDocument {
  id             String             @id @default(uuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id])
  treeItemId     String?
  treeItem       ProductTreeItem?   @relation(fields: [treeItemId], references: [id])
  title          String
  coinPrice      Int                @default(5)
  fileUrl        String
  fileSize       Int
  isApproved     Boolean            @default(false)
  moderatorNote  String? // причина отклонения модератором
  views          Int                @default(0)
  purchasesCount Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  purchasedBy    DocumentPurchase[]

  @@map("library_documents")
  @@index([isApproved, deletedAt])
}

model DocumentPurchase {
  id          String          @id @default(uuid())
  documentId  String
  document    LibraryDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  purchasedAt DateTime        @default(now())

  @@unique([documentId, userId])
  @@map("document_purchases")
  @@index([userId])
}

// ─────────────────────────── КОНФЕРЕНЦИИ ───────────────────────────

model Conference {
  id             String                  @id @default(uuid())
  organizerId    String
  organizer      User                    @relation(fields: [organizerId], references: [id])
  title          String
  logoUrl        String?
  date           DateTime
  time           String
  description    String
  treeItemId     String?
  treeItem       ProductTreeItem?        @relation(fields: [treeItemId], references: [id])
  coinPrice      Int                     @default(0)
  isPublic       Boolean                 @default(true)
  connectionLink String?
  status         String                  @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  moderatorNote  String?
  views          Int                     @default(0)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  participants   ConferenceParticipant[]

  @@map("conferences")
  @@index([status, date])
}

model ConferenceParticipant {
  id           String     @id @default(uuid())
  conferenceId String
  conference   Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  joinedAt     DateTime   @default(now())

  @@unique([conferenceId, userId])
  @@map("conference_participants")
  @@index([userId])
}

// ─────────────────────────── ОПРОСЫ ───────────────────────────

model Poll {
  id         String           @id @default(uuid())
  question   String
  treeItemId String?
  treeItem   ProductTreeItem? @relation(fields: [treeItemId], references: [id])
  pollType   String           @default("DICHOTOMOUS") // DICHOTOMOUS | MULTIPLE
  coinReward Decimal          @default(0.1)
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  options    PollOption[]
  votes      PollVote[]

  @@map("polls")
  @@index([isActive])
}

model PollOption {
  id        String  @id @default(uuid())
  pollId    String
  poll      Poll    @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text      String
  sortOrder Int     @default(0)

  votes     PollVote[]

  @@map("poll_options")
}

model PollVote {
  id        String     @id @default(uuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id])
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  createdAt DateTime   @default(now())

  @@unique([pollId, optionId, userId])
  @@map("poll_votes")
  @@index([userId])
}

// ─────────────────────────── МОНЕТНАЯ ЭКОНОМИКА ───────────────────────────

model Wallet {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Decimal  @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wallets")
}

model Transaction {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  type         String   // ADD_COMPANY | REVIEW | POLL_VOTE | DOCUMENT_SALE | ...
  amount       Decimal
  balanceAfter Decimal
  description  String?
  metadata     String?  // JSON
  createdAt    DateTime @default(now())

  @@map("transactions")
  @@index([userId, createdAt])
}

// ─────────────────────────── СУВЕНИРЫ / ПОДАРКИ ───────────────────────────

model Gift {
  id        String    @id @default(uuid())
  name      String
  coinPrice Int
  limit     Int
  imageUrl  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  claims    GiftClaim[]

  @@map("gifts")
}

model GiftClaim {
  id        String   @id @default(uuid())
  giftId    String
  gift      Gift     @relation(fields: [giftId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  claimDate DateTime @default(now())
  issuedAt  DateTime? // null — ожидает выдачи, заполнено — подарок выдан

  @@map("gift_claims")
}

// ─────────────────────────── БИЛЛИНГ И СЧЕТА ───────────────────────────

model BillingConfig {
  id                  String   @id @default("default")
  coinPriceRub        Decimal  @default(100)
  addCompanyCoins     Decimal  @default(1)
  reviewCoins         Decimal  @default(1)
  vatRate             Decimal  @default(0) // ставка НДС для счетов, % (0 = без НДС)
  invoiceBasis        String?             // основание в счёте, напр. «Договор №1 от 01.01.2026»

  // Ставки по умолчанию для биллинга компаний (₽)
  maintenanceFee      Decimal  @default(1000) // абонентская плата в месяц
  phoneViewPrice      Decimal  @default(50)   // ₽ за 1 просмотр телефона
  emailViewPrice      Decimal  @default(30)   // ₽ за 1 просмотр эл.почты
  websiteViewPrice    Decimal  @default(20)   // ₽ за 1 просмотр сайта
  reviewsViewPrice    Decimal  @default(10)   // ₽ за 1 просмотр отзывов
  ratingViewPrice     Decimal  @default(10)   // ₽ за 1 просмотр рейтинга
  monthlyCap          Decimal?                // потолок счёта по умолчанию, ₽ за период (null = без потолка)
  invoiceDueDays      Int      @default(5)    // срок оплаты счёта, дней
  updatedAt           DateTime @updatedAt

  bankName            String?
  bankInn             String?
  bankBik             String?
  bankAccount         String?
  bankCorrAccount     String?
  organizationName    String?
  organizationAddress String?
  organizationInn     String?
  organizationKpp     String?
  organizationAccount String?
  directorName        String?
  directorPhone       String?
  directorEmail       String?
  signatureImage      String?
  stampImage          String?

  @@map("billing_config")
}

model Invoice {
  id           String         @id @default(uuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id])
  number       String         @unique
  date         DateTime
  dueDate      DateTime
  status       String         @default("DRAFT") // DRAFT | SENT | PAID | SKIPPED | OVERDUE | CANCELLED
  kind         String         @default("PURCHASE") // PURCHASE | BILLING
  subtotal     Decimal
  limit        Decimal
  discount     Decimal        @default(0)
  total        Decimal
  items        InvoiceItem[]
  // Период биллинга и водяная отметка (для kind = BILLING)
  periodFrom     DateTime?
  periodTo       DateTime?
  billedThrough  DateTime?
  act            ServiceAct?
  ticketId     String?        @unique
  ticket       SupportTicket? @relation(fields: [ticketId], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sentAt       DateTime?
  paidAt       DateTime?

  @@index([userId, createdAt])
  @@index([kind, status])
  @@map("invoices")
}

// Акт об оказанных услугах — создаётся при закрытии (оплате) счёта BILLING.
model ServiceAct {
  id        String   @id @default(uuid())
  invoiceId String   @unique
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  number    String   @unique
  date      DateTime
  total     Decimal
  itemsJson String   // JSON: снимок позиций акта на момент закрытия
  createdAt DateTime @default(now())

  @@map("service_acts")
}

// Строки шаблонов документов (счёт за обслуживание и метрики, акт,
// счёт на покупку монет). Тексты редактирует администратор в настройках.
// Плейсхолдеры подставляются при формировании документа.
model DocTemplateLine {
  id          String   @id @default(uuid())
  docKind     String   // billing_invoice | service_act | coin_invoice
  code        String   // ключ строки: maintenance | views | cap | services | license | scope
  label       String   // служебное название строки для администратора
  description String   // текст строки; плейсхолдеры: {period} {metric} {count} {price} {fee} {cap} {breakdown} {days} {invoice} {total} {units} {coins}
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([docKind, code])
  @@map("doc_template_lines")
}

// Счётчики сквозной нумерации документов (СЧ-2026-001, АКТ-2026-001).
model NumberSequence {
  key   String @id // "invoice-2026" | "act-2026"
  value Int    @default(0)

  @@map("number_sequences")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal
  total       Decimal

  @@map("invoice_items")
}

// ─────────────────── СНИМКИ ДЕРЕВА ───────────────────

// Резервные копии дерева решений («как гитхаб»): полный JSON дерева,
// чтобы можно было вернуться к состоянию на момент снимка.
model TreeSnapshot {
  id          String   @id @default(uuid())
  label       String?
  data        String // JSON: TreeItemFlat[] (все узлы, включая удалённые)
  nodeCount   Int      @default(0)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@map("tree_snapshots")
}

// ─────────────────────────── БАННЕРЫ И КОНТЕНТ СТРАНИЦ ───────────────────────────

model PageContent {
  id        String   @id @default(uuid())
  pageKey   String   @unique
  title     String   @default("")
  content   String
  bannerUrl String?
  updatedAt DateTime @updatedAt

  @@map("page_contents")
}

// ─────────────────────────── ОБРАЩЕНИЯ В ПОДДЕРЖКУ ───────────────────────────

model SupportTicket {
  id             String           @id @default(uuid())
  userId         String?
  user           User?            @relation(fields: [userId], references: [id])
  email          String
  phone          String?
  inn            String?
  subject        String
  message        String
  isResolved     Boolean          @default(false)
  userLastReadAt DateTime?
  adminLastReadAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  messages       SupportMessage[]
  invoice        Invoice?

  @@map("support_tickets")
  @@index([isResolved, updatedAt])
}

model SupportMessage {
  id          String        @id @default(uuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?         @relation(fields: [authorId], references: [id])
  isStaff     Boolean       @default(false)
  message     String
  attachments String        @default("[]") // JSON: [{url,name}]
  createdAt   DateTime      @default(now())

  @@map("support_messages")
}

// ─────────────────────────── УВЕДОМЛЕНИЯ ───────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // REVIEW | MODERATION | COINS | SUPPORT | INVOICE | PAYOUT
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

// ─────────────────────────── БАНЫ И АУДИТ ───────────────────────────

model BanLog {
  id        String   @id @default(uuid())
  userId    String
  adminId   String
  action    String // BAN | UNBAN
  reason    String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("ban_logs")
}

model AdminActionLog {
  id         String   @id @default(uuid())
  adminId    String
  adminName  String
  action     String // ban | unban | coins | content | billing | gift | payout | tree | review
  entityType String?
  entityId   String?
  payload    String? // JSON
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@map("admin_action_logs")
}

model ContentRevision {
  id        String   @id @default(uuid())
  pageKey   String
  content   String
  changedBy String
  createdAt DateTime @default(now())

  @@index([pageKey, createdAt])
  @@map("content_revisions")
}
